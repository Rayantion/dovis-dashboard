# =============================================================================
# Dovis dashboard — environment
# =============================================================================
#
# Copy to `.env.local` and fill in. With NONE of these set the app runs in DEMO
# MODE: a complete dashboard on fixtures, no network, no database. That is how
# the public showcase deployment runs, and it is a fine way to look at the design
# before you own a Supabase project.
#
# Supabase Cloud (hosted). Project settings -> API.

# Safe in the browser. Sent to the client by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# =============================================================================
# SERVER ONLY. NEVER PREFIX THIS WITH NEXT_PUBLIC_.
# =============================================================================
# This key bypasses row level security completely. It is what lets the server
# read `todo_payloads` (drafted email bodies) and create accounts. If it reaches
# a browser, every draft Dovis has ever written is readable by anyone with the
# page open, and anyone can mint an owner account.
#
# Project settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# =============================================================================
# GOOGLE — optional. Only works on a real Dovis box, never on the demo.
# =============================================================================
#
# Lets the principal connect Gmail and Calendar by clicking a button, instead of
# the operator SSHing in and hand-placing a client JSON. The callback writes the
# credentials to THIS MACHINE's filesystem, in the directory the MCP server reads,
# so no token ever enters the database or crosses a network. Leave these unset and
# the Google card simply does not appear.
#
# In Google Cloud Console: enable the Gmail API and the Calendar API, then create
# an OAuth client ID of type **Web application**, with the redirect URI below.
#
# SET THE USER TYPE TO **INTERNAL** if the principal has Google Workspace. An
# External app with publishing status "Testing" issues a refresh token that EXPIRES
# AFTER 7 DAYS for Gmail scopes — Dovis then stops reading mail every week and it
# presents as a broken cron rather than an expired grant. Internal is exempt from
# that and from verification entirely.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the authorised redirect URI on the OAuth client, exactly.
GOOGLE_REDIRECT_URI=https://dovis.your-domain.com/api/google/callback

# Where the MCP server reads its credentials from. Match whatever
# --credentials-dir / --gauth-file / --accounts-file the server is launched with.
GOOGLE_CREDENTIALS_DIR=/home/jarvis/mcp-google-workspace

# VERIFY THIS ONE. The filename the MCP server looks for inside the credentials
# directory. A wrong value fails in the worst way: OAuth succeeds, the dashboard
# says connected, and the agent still cannot read mail. Run the server's own CLI
# auth once, `ls -a` the directory, and copy the exact filename it produced.
GOOGLE_TOKEN_FILE_PATTERN=.oauth2.{email}.json
