# =============================================================================
# Dovis dashboard — environment
# =============================================================================
#
# Copy to `.env.local` and fill in. With NONE of these set the app runs in DEMO
# MODE: a complete dashboard on fixtures, no network, no database. That is how
# the public showcase deployment runs, and it is a fine way to look at the design
# before you own a Supabase project.
#
# Supabase Cloud (hosted). Project settings -> API.

# Safe in the browser. Sent to the client by design.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# =============================================================================
# SERVER ONLY. NEVER PREFIX THIS WITH NEXT_PUBLIC_.
# =============================================================================
# This key bypasses row level security completely. It is what lets the server
# read `todo_payloads` (drafted email bodies) and create accounts. If it reaches
# a browser, every draft Dovis has ever written is readable by anyone with the
# page open, and anyone can mint an owner account.
#
# Project settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
